{% extends 'base.html.twig' %}

{% block title %}Location Sources{% endblock %}

{% block body %}
    <main class="m-3">
        <h1>Location Sources</h1>
        {% for message in app.flashes('timeline_source') %}
            <p class="alert alert-success" role="status">{{ message }}</p>
        {% endfor %}
        <a class="btn btn-primary btn-sm" href="{{ path('source_new') }}" role="button">New</a>
        <table class="table">
            <thead>
            <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Name</th>
                <th>Enabled</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for item in items %}
                {% set is_owntracks = item.sourceType == owntracks_type %}
                {% set is_timeline = item.sourceType == timeline_type %}
                <tr>
                    <th scope="row">{{ item.id }}</th>
                    <td>{{ is_owntracks ? 'OwnTracks' : (is_timeline ? 'Google Timeline' : item.sourceType) }}</td>
                    <td>{{ item.name }}</td>
                    <td>{{ item.deletedAt is null ? 'Yes' : 'No' }}</td>
                    <td>
                        {% if is_owntracks and item.deletedAt is null %}
                            <form action="{{ path('source_delete', {id: item.id}) }}" method="post" onsubmit="return confirm('Really?')">
                                <input type="hidden" name="token" value="{{ csrf_token('delete-item') }}">
                                <input type="hidden" name="id" value="{{ item.id }}">
                                <input type="submit" class="btn btn-danger" value="Disable" />
                            </form>
                        {% elseif is_timeline %}
                            <a class="btn btn-danger" href="{{ path('source_timeline_remove', {id: item.id}) }}">Delete</a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {{ ux_pagination(items) }}
    </main>
{% endblock %}
